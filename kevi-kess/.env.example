PORT=3000
# Windows integrated authentication is used for SQL Server.
SQL_SERVER=localhost
SQL_DATABASE=kevi_kess
SQL_PORT=1433
SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true
# For a named SQL Server instance, set this (for example SQLEXPRESS):
# SQL_INSTANCE_NAME=SQLEXPRESS
# Credentials for the /admin dashboard and /api/admin/* endpoints
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Set to 1 if running behind a reverse proxy (nginx, etc.) so rate limiting sees real IPs
TRUST_PROXY=0
